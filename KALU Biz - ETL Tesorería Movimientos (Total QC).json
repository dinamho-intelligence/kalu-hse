    {
      "parameters": {
        "jsCode": "const EMPRESA_ID = '1e77b05c-a142-4314-aab6-f8d4637b5586';\nfunction fecha(f){ if(!f) return null; if(f instanceof Date) return f.toISOString().slice(0,10); const s=String(f).trim(); const m=s.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/); return m ? `${m[3]}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}` : null; }\nfunction num(v){ if(v===null||v===undefined||v==='') return null; const n=Number(v); return isNaN(n)?null:n; }\nconst out=[];\nfor(const item of $input.all()){\n  const r=item.json;\n  const valor = num(r['Valor']);\n  if (valor===null) continue;\n  out.push({ json: {\n    empresa_id: EMPRESA_ID,\n    fecha: fecha(r['Fecha cargue']),\n    banco: r['Banco'] ? String(r['Banco']).trim() : null,\n    clasificacion_texto: r['Clasificación'] ? String(r['Clasificación']).trim() : null,\n    valor,\n    proveedor: r['Proveedor'] ? String(r['Proveedor']).trim() : null,\n    estado_factura_oc: r['Estado'] ? String(r['Estado']).trim() : null,\n    codigo_trazable: r['Código trazable'] ? String(r['Código trazable']).trim() : null,\n    detalle_depurado: r['Detalle depurado'] ? String(r['Detalle depurado']).trim() : null,\n    referencia: r['Concepto'] ? String(r['Concepto']).trim() : null,\n    origen_hoja: 'Control',\n  }});\n}\nreturn out;"
      },
