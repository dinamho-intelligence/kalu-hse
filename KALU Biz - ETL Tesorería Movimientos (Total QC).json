    {
      "parameters": {
        "jsCode": "const EMPRESA_ID = '1e77b05c-a142-4314-aab6-f8d4637b5586';\nfunction fecha(f){ if(!f) return null; if(f instanceof Date) return f.toISOString().slice(0,10); const s=String(f).trim(); const m=s.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/); return m ? `${m[3]}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}` : null; }\nfunction num(v){ if(v===null||v===undefined||v==='') return null; const n=Number(v); return isNaN(n)?null:n; }\n\nconst out=[];\nfor(const item of $input.all()){\n  const r=item.json;\n  if (r['Fecha cargue'] === 'Total') continue; // fila de totales\n  const valor = num(r[' Valor ']); // OJO: espacios\n  if (valor===null) continue;\n  out.push({ json: {\n    empresa_id: EMPRESA_ID,\n    fecha: fecha(r['Fecha cargue']),\n    banco: r['Banco'] ? String(r['Banco']).trim() : null,\n    clasificacion_texto: r['Clasificación'] ? String(r['Clasificación']).trim() : null,\n    valor,\n    referencia: r['Detalle'] ? String(r['Detalle']).trim() : null,\n    origen_hoja: 'Anticipos',\n  }});\n}\nreturn out;"
      },
      "id": "6fd8f7c8-ce2b-47fc-bc25-993df7fbc69e",
      "name": "Normalizar Anticipos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const EMPRESA_ID = '1e77b05c-a142-4314-aab6-f8d4637b5586';\nfunction fecha(f){ if(!f) return null; if(f instanceof Date) return f.toISOString().slice(0,10); const s=String(f).trim(); const m=s.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/); return m ? `${m[3]}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}` : null; }\nfunction num(v){ if(v===null||v===undefined||v==='') return null; const n=Number(v); return isNaN(n)?null:n; }\n\nconst out=[];\nfor(const item of $input.all()){\n  const r=item.json;\n  const concepto = r['Concepto'] ? String(r['Concepto']).trim() : null;\n  if (!concepto) continue; // descarta la fila de totales, que no trae Concepto\n  const valor = num(r[' Valor Bruto ']); // OJO: espacios\n  if (valor===null) continue;\n  out.push({ json: {\n    empresa_id: EMPRESA_ID,\n    fecha: fecha(r['Fecha de solicitud']),\n    clasificacion_texto: concepto,\n    valor,\n    estado_factura_oc: r['Estado'] ? String(r['Estado']).trim() : null,\n    referencia: r['Vencimiento'] ? String(r['Vencimiento']) : null,\n    origen_hoja: 'Impuestos',\n  }});\n}\nreturn out;"
      },
      "id": "1c28d8d8-c301-4bde-9125-137ad9de3dc8",
      "name": "Normalizar Impuestos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        496
      ]
    },
    {
      "parameters": {
        "jsCode": "function num(v){ if(v===null||v===undefined||v==='') return null; const n=Number(v); return isNaN(n)?null:n; }\nfunction fecha(f){ if(!f) return null; if(f instanceof Date) return f.toISOString().slice(0,10); const s=String(f).trim(); const m=s.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/); return m ? `${m[3]}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}` : null; }\n\nconst porPO = new Map(); // dedupe: se queda con la última aparición de cada PO\nfor(const item of $input.all()){\n  const r=item.json;\n  const po = r['PO'] ? String(r['PO']).trim() : null;\n  if (!po) continue;\n  porPO.set(po, {\n    empresa_id: '1e77b05c-a142-4314-aab6-f8d4637b5586',\n    orden_compra: po,\n    valor_factura: num(r['VALOR FACTURA']),\n    abono_factura: num(r['ABONO FACTURA']),\n    saldo_factura: num(r['SALDO FACTURA']),\n    fecha_vencimiento: fecha(r['FECHA V/CTO']),\n    estado_factura: r['ESTADO FACTURA'] ? String(r['ESTADO FACTURA']).trim() : null,\n  });\n}\nreturn Array.from(porPO.values()).map(json => ({ json }));"
      },
